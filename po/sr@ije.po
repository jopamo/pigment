#: gdk-pixbuf/gdk-pixbuf-animation.c:146 gdk-pixbuf/gdk-pixbuf-io.c:1083
#: gdk-pixbuf/gdk-pixbuf-io.c:1349
#, c-format
msgid "Failed to open file '%s': %s"
msgstr "Не могу да отворим датотеку „%s“: %s"

