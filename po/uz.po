#: gdk-pixbuf/gdk-pixbuf-animation.c:185 gdk-pixbuf/gdk-pixbuf-io.c:1129
#: gdk-pixbuf/gdk-pixbuf-io.c:1402
#, c-format
msgid "Failed to open file “%s”: %s"
msgstr "“%s” faylini ochib bo‘lmadi: %s"

#: gdk-pixbuf/gdk-pixbuf-animation.c:198 gdk-pixbuf/gdk-pixbuf-io.c:990
#, c-format
msgid "Image file “%s” contains no data"
msgstr "“%s” rasm faylida maʼlumotlar yoʻq"

#: gdk-pixbuf/gdk-pixbuf-animation.c:236
#, c-format
msgid ""
"Failed to load animation “%s”: reason not known, probably a corrupt "
"animation file"
msgstr ""
"'%s' : animatsiyasini yuklab boʻlmadi: sababi nomaʼlum, balki fayl buzuq "
"boʻlishi mumkin"

#: gdk-pixbuf/gdk-pixbuf-animation.c:304 gdk-pixbuf/gdk-pixbuf-io.c:1165
#: gdk-pixbuf/gdk-pixbuf-io.c:1454
#, c-format
msgid ""
"Failed to load image “%s”: reason not known, probably a corrupt image file"
msgstr ""
"'%s' rasmini yuklab boʻlmadi: sababi nomaʼlum, balki fayl buzuq boʻlishi "
"mumkin"

#: gdk-pixbuf/gdk-pixbuf.c:248
msgid "Number of Channels"
msgstr "Kanallar soni"

#: gdk-pixbuf/gdk-pixbuf.c:249
msgid "The number of samples per pixel"
msgstr "Bir piksel uchun namunalar soni"

#: gdk-pixbuf/gdk-pixbuf.c:264
msgid "Colorspace"
msgstr "Rang maydoni"

#: gdk-pixbuf/gdk-pixbuf.c:265
msgid "The colorspace in which the samples are interpreted"
msgstr "Namunalar talqin qilinadigan rang maydoni"

#: gdk-pixbuf/gdk-pixbuf.c:277
msgid "Has Alpha"
msgstr "Alfa bor"

#: gdk-pixbuf/gdk-pixbuf.c:278
msgid "Whether the pixbuf has an alpha channel"
msgstr "Pixbufda alfa kanali bormi"

#: gdk-pixbuf/gdk-pixbuf.c:291
msgid "Bits per Sample"
msgstr "Bitta namuna uchun"

#: gdk-pixbuf/gdk-pixbuf.c:292
msgid "The number of bits per sample"
msgstr "Bitta namunadagi bitlar soni"

#: gdk-pixbuf/gdk-pixbuf.c:305
msgid "Width"
msgstr "Kengligi"

#: gdk-pixbuf/gdk-pixbuf.c:306
msgid "The number of columns of the pixbuf"
msgstr "Pixbuf ustunlari soni"

#: gdk-pixbuf/gdk-pixbuf.c:319
msgid "Height"
msgstr "Balandligi"

#: gdk-pixbuf/gdk-pixbuf.c:320
msgid "The number of rows of the pixbuf"
msgstr "Pixbuf qatorlari soni"

#: gdk-pixbuf/gdk-pixbuf.c:337
msgid "Rowstride"
msgstr "Rowstride"

#: gdk-pixbuf/gdk-pixbuf.c:338
msgid ""
"The number of bytes between the start of a row and the start of the next row"
msgstr "Qator boshi va keyingi qator boshi orasidagi baytlar soni"

#: gdk-pixbuf/gdk-pixbuf.c:351
msgid "Pixels"
msgstr "Piksellar"

#: gdk-pixbuf/gdk-pixbuf.c:352
msgid "A pointer to the pixel data of the pixbuf"
msgstr "Pixbufning piksel ma'lumotlariga ko'rsatgich"

#: gdk-pixbuf/gdk-pixbuf.c:366
msgid "Pixel Bytes"
msgstr "Piksel bayt"

#: gdk-pixbuf/gdk-pixbuf.c:367
msgid "Readonly pixel data"
msgstr "Faqat o'qish uchun piksel ma'lumotlari"

#: gdk-pixbuf/gdk-pixbuf-io.c:807
#, c-format
msgid "Unable to load image-loading module: %s: %s"
msgstr "Rasm yuklash modulini yuklab boʻlmadi: %s: %s"

#: gdk-pixbuf/gdk-pixbuf-io.c:824
#, c-format
msgid ""
"Image-loading module %s does not export the proper interface; perhaps it’s "
"from a different gdk-pixbuf version?"
msgstr ""
"Rasmni yuklash moduli %s tegishli interfeysni eksport qilmaydi; ehtimol u "
"boshqa gdk-pixbuf versiyasidandir?"

#: gdk-pixbuf/gdk-pixbuf-io.c:834 gdk-pixbuf/gdk-pixbuf-io.c:877
#, c-format
msgid "Image type “%s” is not supported"
msgstr "'%s' rasm turi qoʻllanilmaydi"

#: gdk-pixbuf/gdk-pixbuf-io.c:962
#, c-format
msgid "Couldn’t recognize the image file format for file “%s”"
msgstr "'%s' faylidagi rasm formatini aniqlab boʻlmadi"

#: gdk-pixbuf/gdk-pixbuf-io.c:970
msgid "Unrecognized image file format"
msgstr "Nomaʼlum rasm formati"

#: gdk-pixbuf/gdk-pixbuf-io.c:1176
#, c-format
msgid "Failed to load image “%s”: %s"
msgstr "'%s' rasmi yuklanmadi: %s"

#: gdk-pixbuf/gdk-pixbuf-io.c:2244 gdk-pixbuf/io-gdip-utils.c:840
#, c-format
msgid "Error writing to image file: %s"
msgstr "Rasm fayliga yozishda xatolik yuz berdi: %s"

#: gdk-pixbuf/gdk-pixbuf-io.c:2286 gdk-pixbuf/gdk-pixbuf-io.c:2407
#, c-format
msgid "This build of gdk-pixbuf does not support saving the image format: %s"
msgstr ""
"Ushbu gdk-pixbuf qurilmasi rasm formatini saqlashni qo‘llab-quvvatlamaydi: %s"

#: gdk-pixbuf/gdk-pixbuf-io.c:2317
msgid "Insufficient memory to save image to callback"
msgstr "Rasmni qayta qo'ng'iroq qilish uchun saqlash uchun xotira yetarli emas"

#: gdk-pixbuf/gdk-pixbuf-io.c:2330
msgid "Failed to open temporary file"
msgstr "Vaqtinchalik faylni ochib boʻlmadi"

#: gdk-pixbuf/gdk-pixbuf-io.c:2353
msgid "Failed to read from temporary file"
msgstr "Vaqtinchalik fayldan oʻqib boʻlmadi"

#: gdk-pixbuf/gdk-pixbuf-io.c:2575
#, c-format
msgid "Failed to open “%s” for writing: %s"
msgstr "'%s' faylini yozish uchun ochib boʻlmadi: %s"

#: gdk-pixbuf/gdk-pixbuf-io.c:2601
#, c-format
msgid ""
"Failed to close “%s” while writing image, all data may not have been saved: "
"%s"
msgstr ""
"Rasm yozish paytida “%s” yopilmadi, barcha maʼlumotlar saqlanmagan boʻlishi "
"mumkin: %s"

#: gdk-pixbuf/gdk-pixbuf-io.c:2835 gdk-pixbuf/gdk-pixbuf-io.c:2890
msgid "Insufficient memory to save image into a buffer"
msgstr "Rasmni buferga saqlash uchun xotira yetishmaydi"

#: gdk-pixbuf/gdk-pixbuf-io.c:2936
msgid "Error writing to image stream"
msgstr "Rasm oqimiga yozishda xatolik yuz berdi"

#: gdk-pixbuf/gdk-pixbuf-loader.c:416
#, c-format
msgid ""
"Internal error: Image loader module “%s” failed to complete an operation, "
"but didn’t give a reason for the failure"
msgstr ""
"Ichki xato: “%s” tasvir yuklash moduli operatsiyani yakunlay olmadi, lekin "
"xato sababini ko‘rsatmadi"

#: gdk-pixbuf/gdk-pixbuf-loader.c:458
#, c-format
msgid "Incremental loading of image type “%s” is not supported"
msgstr "'%s' rasm turi qoʻllanilmaydi"

#: gdk-pixbuf/gdk-pixbuf-simple-anim.c:162
msgid "Loop"
msgstr "Loop"

#: gdk-pixbuf/gdk-pixbuf-simple-anim.c:163
msgid "Whether the animation should loop when it reaches the end"
msgstr "Animatsiya oxiriga yetganda aylanish kerakmi"

#: gdk-pixbuf/gdk-pixdata.c:178
msgid "Image header corrupt"
msgstr "Rasm saravhasi buzuq"

#: gdk-pixbuf/gdk-pixdata.c:183
msgid "Image format unknown"
msgstr "Rasm formati nomaʼlum"

#: gdk-pixbuf/gdk-pixdata.c:188 gdk-pixbuf/gdk-pixdata.c:491
#: gdk-pixbuf/gdk-pixdata.c:501 gdk-pixbuf/gdk-pixdata.c:597
msgid "Image pixel data corrupt"
msgstr "Rasmning piksel maʼlumotlari xato"

#: gdk-pixbuf/gdk-pixdata.c:513
#, c-format
msgid "failed to allocate image buffer of %u byte"
msgid_plural "failed to allocate image buffer of %u bytes"
msgstr[0] "%u baytlik rasm buferini ajratib boʻlmadi"
msgstr[1] "%u baytlik rasm buferini ajratib boʻlmadi"

#: gdk-pixbuf/io-bmp.c:231 gdk-pixbuf/io-bmp.c:269 gdk-pixbuf/io-bmp.c:376
#: gdk-pixbuf/io-bmp.c:403 gdk-pixbuf/io-bmp.c:428 gdk-pixbuf/io-bmp.c:463
#: gdk-pixbuf/io-bmp.c:485 gdk-pixbuf/io-bmp.c:563
msgid "BMP image has bogus header data"
msgstr "BMP tasvirida soxta sarlavha ma'lumotlari mavjud"

#: gdk-pixbuf/io-bmp.c:242 gdk-pixbuf/io-bmp.c:498
msgid "Not enough memory to load bitmap image"
msgstr "Bitmap tasvirni yuklash uchun xotira yetarli emas"

#: gdk-pixbuf/io-bmp.c:333
msgid "BMP image has unsupported header size"
msgstr "BMP tasviri qoʻllab-quvvatlanmaydigan sarlavha hajmiga ega"

#: gdk-pixbuf/io-bmp.c:343
msgid "BMP image has unsupported depth"
msgstr "BMP tasviri qoʻllab-quvvatlanmaydigan chuqurlikka ega"

#: gdk-pixbuf/io-bmp.c:358
msgid "BMP image has oversize palette"
msgstr "BMP tasviri katta hajmli palitraga ega"

#: gdk-pixbuf/io-bmp.c:390
msgid "Topdown BMP images cannot be compressed"
msgstr "Yuqoridan pastga BMP tasvirlarni siqib bo'lmaydi"

#: gdk-pixbuf/io-bmp.c:415
msgid "BMP image width too large"
msgstr "BMP tasvir kengligi juda katta"

#: gdk-pixbuf/io-bmp.c:792 gdk-pixbuf/io-png.c:564 gdk-pixbuf/io-pnm.c:722
#: gdk-pixbuf/io-pnm.c:879
msgid "Premature end-of-file encountered"
msgstr "Faylning muddatidan oldin tugashiga duch keldi"

#: gdk-pixbuf/io-bmp.c:1313
msgid "Error while decoding colormap"
msgstr "Rang xaritasini dekodlashda xatolik yuz berdi"

#: gdk-pixbuf/io-bmp.c:1376 gdk-pixbuf/io-bmp.c:1388
msgid "Image is too wide for BMP format."
msgstr "Rasm BMP formati uchun juda keng."

#: gdk-pixbuf/io-bmp.c:1421
msgid "Couldn’t allocate memory for saving BMP file"
msgstr "Meta-faylni yuklab boʻlmadi"

#: gdk-pixbuf/io-bmp.c:1462
msgid "Couldn’t write to BMP file"
msgstr "BMP fayliga yozib boʻlmadi"

#: gdk-pixbuf/io-bmp.c:1515 gdk-pixbuf/io-gdip-bmp.c:83
msgctxt "image format"
msgid "BMP"
msgstr "BMP"

#: gdk-pixbuf/io-gdip-gif.c:81 gdk-pixbuf/io-gif.c:1037
msgctxt "image format"
msgid "GIF"
msgstr "GIF"

#: gdk-pixbuf/io-gdip-ico.c:60 gdk-pixbuf/io-ico.c:1412
msgctxt "image format"
msgid "Windows icon"
msgstr "Windows belgisi"

#: gdk-pixbuf/io-gdip-jpeg.c:54 gdk-pixbuf/io-jpeg.c:1394
#, c-format
msgid ""
"JPEG quality must be a value between 0 and 100; value “%s” could not be "
"parsed."
msgstr ""
"JPEG sifati 0 dan 100 gacha bo'lgan qiymat bo'lishi kerak; “%s” qiymatini "
"tahlil qilib bo‘lmadi."

#: gdk-pixbuf/io-gdip-jpeg.c:69 gdk-pixbuf/io-jpeg.c:1410
#, c-format
msgid ""
"JPEG quality must be a value between 0 and 100; value “%d” is not allowed."
msgstr ""
"JPEG sifati 0 dan 100 gacha bo'lgan qiymat bo'lishi kerak; “%d” qiymatiga "
"ruxsat berilmagan."

#: gdk-pixbuf/io-gdip-jpeg.c:147 gdk-pixbuf/io-jpeg.c:1694
msgctxt "image format"
msgid "JPEG"
msgstr "JPEG"

#: gdk-pixbuf/io-gdip-tiff.c:83 gdk-pixbuf/io-tiff.c:1087
msgctxt "image format"
msgid "TIFF"
msgstr "TIFF"

#: gdk-pixbuf/io-gif.c:158
#, c-format
msgid "Failure reading GIF: %s"
msgstr "GIF o‘qilmadi: %s"

#: gdk-pixbuf/io-gif.c:381 gdk-pixbuf/io-gif.c:848 gdk-pixbuf/io-gif.c:901
#: gdk-pixbuf/io-gif.c:974
msgid "Not enough memory to load GIF file"
msgstr "GIF faylini yuklash uchun xotira yetarli emas"

#: gdk-pixbuf/io-gif.c:507
msgid "GIF image is corrupt (incorrect LZW compression)"
msgstr "GIF tasviri buzilgan (noto'g'ri LZW siqish)"

#: gdk-pixbuf/io-gif.c:543
msgid "File does not appear to be a GIF file"
msgstr "Fayl GIF fayli emas"

#: gdk-pixbuf/io-gif.c:558
#, c-format
msgid "Version %s of the GIF file format is not supported"
msgstr "GIF fayl formatining %s-versiyasi qo‘llab-quvvatlanmaydi"

#: gdk-pixbuf/io-gif.c:587
msgid "Resulting GIF image has zero size"
msgstr "Natijadagi GIF tasviri nolga teng"

#: gdk-pixbuf/io-gif.c:657
msgid ""
"GIF image has no global colormap, and a frame inside it has no local "
"colormap."
msgstr ""
"GIF rasmida global rang xaritasi yo'q va uning ichidagi ramkada mahalliy "
"rang xaritasi yo'q."

#: gdk-pixbuf/io-gif.c:861 gdk-pixbuf/io-gif.c:986
msgid "GIF file was missing some data (perhaps it was truncated somehow?)"
msgstr ""
"GIF faylida ba'zi ma'lumotlar yo'q edi (ehtimol u qandaydir tarzda "
"kesilganmi?)"

#: gdk-pixbuf/io-gif.c:920
msgid "GIF image was truncated or incomplete."
msgstr "GIF tasviri kesilgan yoki toʻliq boʻlmagan."

#: gdk-pixbuf/io-gif.c:927
msgid "Not all frames of the GIF image were loaded."
msgstr "GIF tasvirining barcha ramkalari yuklanmagan."

#: gdk-pixbuf/io-ico.c:238 gdk-pixbuf/io-ico.c:252 gdk-pixbuf/io-ico.c:342
#: gdk-pixbuf/io-ico.c:426 gdk-pixbuf/io-ico.c:451
#, c-format
msgid "Invalid header in icon (%s)"
msgstr "Belgidagi sarlavha noto‘g‘ri (%s)"

#: gdk-pixbuf/io-ico.c:268 gdk-pixbuf/io-ico.c:355 gdk-pixbuf/io-ico.c:461
#: gdk-pixbuf/io-ico.c:504 gdk-pixbuf/io-ico.c:532
msgid "Not enough memory to load icon"
msgstr "Belgini yuklash uchun xotira yetarli emas"

#: gdk-pixbuf/io-ico.c:386
msgid "Invalid header in icon"
msgstr "Belgidagi sarlavha noto‘g‘ri"

#: gdk-pixbuf/io-ico.c:387
msgid "Compressed icons are not supported"
msgstr "Siqilgan piktogrammalar qo'llab-quvvatlanmaydi"

#: gdk-pixbuf/io-ico.c:489
msgid "Unsupported icon type"
msgstr "Qo'llab-quvvatlanmaydigan belgi turi"

#: gdk-pixbuf/io-ico.c:583
msgid "Not enough memory to load ICO file"
msgstr "ICO faylini yuklash uchun xotira yetarli emas"

#: gdk-pixbuf/io-ico.c:629
msgid "ICO image was truncated or incomplete."
msgstr "ICO tasviri kesilgan yoki toʻliq boʻlmagan."

#: gdk-pixbuf/io-ico.c:1070
msgid "Image too large to be saved as ICO"
msgstr "Rasm ICO sifatida saqlash uchun juda katta"

#: gdk-pixbuf/io-ico.c:1081
msgid "Cursor hotspot outside image"
msgstr "Kursorning kirish nuqtasi tasvir tashqarisi"

#: gdk-pixbuf/io-ico.c:1104
#, c-format
msgid "Unsupported depth for ICO file: %d"
msgstr "ICO fayli uchun qoʻllab-quvvatlanmaydigan chuqurlik: %d"

#: gdk-pixbuf/io-jpeg.c:129
#, c-format
msgid "Error interpreting JPEG image file (%s)"
msgstr "JPEG rasm faylini talqin qilishda xatolik yuz berdi (%s)"

#: gdk-pixbuf/io-jpeg.c:638
msgid ""
"Insufficient memory to load image, try exiting some applications to free "
"memory"
msgstr ""
"Rasmni yuklash uchun xotira yetarli emas, xotirani boʻshatish uchun baʼzi "
"ilovalardan chiqib koʻring"

#: gdk-pixbuf/io-jpeg.c:711 gdk-pixbuf/io-jpeg.c:956
#, c-format
msgid "Unsupported JPEG color space (%s)"
msgstr "Qo'llab-quvvatlanmaydigan JPEG rang maydoni (%s)"

#: gdk-pixbuf/io-jpeg.c:834 gdk-pixbuf/io-jpeg.c:1154 gdk-pixbuf/io-jpeg.c:1501
#: gdk-pixbuf/io-jpeg.c:1511
msgid "Couldn’t allocate memory for loading JPEG file"
msgstr "Meta-faylni yuklab boʻlmadi"

#: gdk-pixbuf/io-jpeg.c:1112
msgid "Transformed JPEG has zero width or height."
msgstr "O'zgartirilgan JPEG kengligi yoki balandligi nolga teng."

#: gdk-pixbuf/io-jpeg.c:1138
#, c-format
msgid "Unsupported number of color components (%d)"
msgstr "Rang komponentlarining qoʻllab-quvvatlanmaydigan soni (%d)"

#: gdk-pixbuf/io-jpeg.c:1431
#, c-format
msgid ""
"JPEG x-dpi must be a value between 1 and 65535; value “%s” is not allowed."
msgstr ""
"JPEG x-dpi qiymati 1 va 65535 oralig'ida bo'lishi kerak; “%s” qiymatiga "
"ruxsat berilmagan."

#: gdk-pixbuf/io-jpeg.c:1452
#, c-format
msgid ""
"JPEG y-dpi must be a value between 1 and 65535; value “%s” is not allowed."
msgstr ""
"JPEG y-dpi 1 dan 65535 gacha bo'lgan qiymat bo'lishi kerak; “%s” qiymatiga "
"ruxsat berilmagan."

#: gdk-pixbuf/io-jpeg.c:1466
#, c-format
msgid "Color profile has invalid length “%u”."
msgstr "Rang profilining uzunligi “%u” yaroqsiz."

#: gdk-pixbuf/io-png.c:63
msgid "Bits per channel of PNG image is invalid."
msgstr "PNG tasvirining har bir kanali uchun bitlar yaroqsiz."

#: gdk-pixbuf/io-png.c:144 gdk-pixbuf/io-png.c:703
msgid "Transformed PNG has zero width or height."
msgstr "O'zgartirilgan PNG kengligi yoki balandligi nolga teng."

#: gdk-pixbuf/io-png.c:152
msgid "Bits per channel of transformed PNG is not 8."
msgstr "O'zgartirilgan PNG kanali uchun bitlar 8 emas."

#: gdk-pixbuf/io-png.c:161
msgid "Transformed PNG not RGB or RGBA."
msgstr "RGB yoki RGBA emas, o'zgartirilgan PNG."

#: gdk-pixbuf/io-png.c:170
msgid "Transformed PNG has unsupported number of channels, must be 3 or 4."
msgstr ""
"Oʻzgartirilgan PNG formatida qoʻllab-quvvatlanmaydigan kanallar soni 3 yoki "
"4 ta boʻlishi kerak."

#: gdk-pixbuf/io-png.c:191
#, c-format
msgid "Fatal error in PNG image file: %s"
msgstr "PNG rasm faylida jiddiy xatolik: %s"

#: gdk-pixbuf/io-png.c:329
msgid "Insufficient memory to load PNG file"
msgstr "PNG faylini yuklash uchun xotira yetarli emas"

#: gdk-pixbuf/io-png.c:498 gdk-pixbuf/io-png.c:519
msgid "Couldn’t allocate memory for loading PNG"
msgstr "Meta-faylni yuklab boʻlmadi"

#: gdk-pixbuf/io-png.c:716
#, c-format
msgid ""
"Insufficient memory to store a %lu by %lu image; try exiting some "
"applications to reduce memory usage"
msgstr ""
"%lu x %lu tasvirni saqlash uchun xotira yetarli emas; xotiradan "
"foydalanishni kamaytirish uchun ba'zi ilovalardan chiqishga harakat qiling"

#: gdk-pixbuf/io-png.c:791
msgid "Fatal error reading PNG image file"
msgstr "PNG rasm faylini oʻqishda jiddiy xato"

#: gdk-pixbuf/io-png.c:840
#, c-format
msgid "Fatal error reading PNG image file: %s"
msgstr "PNG rasm faylini oʻqishda jiddiy xatolik: %s"

#: gdk-pixbuf/io-png.c:937
#, c-format
msgid ""
"Invalid key “%s”. Keys for PNG text chunks must have at least 1 and at most "
"79 characters."
msgstr ""
"“%s” kaliti noto‘g‘ri. PNG matn qismlari uchun kalitlar kamida 1 va koʻpi "
"bilan 79 ta belgidan iborat boʻlishi kerak."

#: gdk-pixbuf/io-png.c:950
#, c-format
msgid "Invalid key “%s”. Keys for PNG text chunks must be ASCII characters."
msgstr ""
"“%s” kaliti noto‘g‘ri. PNG matn qismlari uchun kalitlar ASCII belgilar "
"boʻlishi kerak."

#: gdk-pixbuf/io-png.c:980
#, c-format
msgid ""
"Value for PNG text chunk '%s' cannot be converted to ISO-8859-1 encoding."
msgstr ""
"“%s” PNG matn qismi qiymatini ISO-8859-1 kodlashiga aylantirib bo‘lmaydi."

#: gdk-pixbuf/io-png.c:992
#, c-format
msgid "Color profile has invalid length %d"
msgstr "Rang profilining uzunligi %d yaroqsiz"

#: gdk-pixbuf/io-png.c:1004
#, c-format
msgid ""
"PNG compression level must be a value between 0 and 9; value “%s” is invalid"
msgstr ""
"PNG siqish darajasi 0 dan 9 gacha bo'lgan qiymat bo'lishi kerak; “%s” "
"qiymati noto‘g‘ri"

#: gdk-pixbuf/io-png.c:1018
#, c-format
msgid "PNG %s must be greater than zero; value “%s” is not allowed"
msgstr "PNG %s noldan katta boʻlishi kerak; “%s” qiymatiga ruxsat berilmagan"

#: gdk-pixbuf/io-png.c:1246
msgctxt "image format"
msgid "PNG"
msgstr "PNG"

#: gdk-pixbuf/io-tiff.c:117
msgid "Could not get image width (bad TIFF file)"
msgstr "Tasvir kengligi olinmadi (yomon TIFF fayli)"

#: gdk-pixbuf/io-tiff.c:125
msgid "Could not get image height (bad TIFF file)"
msgstr "Tasvir balandligini olinmadi (yomon TIFF fayli)"

#: gdk-pixbuf/io-tiff.c:133
msgid "Width or height of TIFF image is zero"
msgstr "TIFF tasvirining kengligi yoki balandligi nolga teng"

#: gdk-pixbuf/io-tiff.c:141 gdk-pixbuf/io-tiff.c:151
msgid "Dimensions of TIFF image too large"
msgstr "TIFF tasvirining oʻlchamlari juda katta"

#: gdk-pixbuf/io-tiff.c:177 gdk-pixbuf/io-tiff.c:189 gdk-pixbuf/io-tiff.c:585
msgid "Insufficient memory to open TIFF file"
msgstr "TIFF faylini ochish uchun xotira yetarli emas"

#: gdk-pixbuf/io-tiff.c:287
msgid "Failed to load RGB data from TIFF file"
msgstr "TIFF faylidan RGB maʼlumotlarini yuklab boʻlmadi"

#: gdk-pixbuf/io-tiff.c:378
msgid "Failed to open TIFF image"
msgstr "TIFF tasvirini ochib bo‘lmadi"

#: gdk-pixbuf/io-tiff.c:516 gdk-pixbuf/io-tiff.c:528
msgid "Failed to load TIFF image"
msgstr "TIFF tasvirini yuklab bo‘lmadi"

#: gdk-pixbuf/io-tiff.c:760
msgid "Failed to save TIFF image"
msgstr "TIFF tasvirini saqlab bo‘lmadi"

#: gdk-pixbuf/io-tiff.c:821
msgid "TIFF compression doesn’t refer to a valid codec."
msgstr "TIFF siqish haqiqiy kodekga ishora qilmaydi."

#: gdk-pixbuf/io-tiff.c:851
#, c-format
msgid "Color profile has invalid length %d."
msgstr "Rang profilining uzunligi %d yaroqsiz."

#: gdk-pixbuf/io-tiff.c:866
msgid "TIFF bits-per-sample doesn’t contain a supported value."
msgstr ""
"Namuna boshiga TIFF bitlari qo‘llab-quvvatlanadigan qiymatni o‘z ichiga "
"olmaydi."

#: gdk-pixbuf/io-tiff.c:947
msgid "Failed to write TIFF data"
msgstr "TIFF maʼlumotlarini yozib boʻlmadi"

#: gdk-pixbuf/io-tiff.c:965
#, c-format
msgid "TIFF x-dpi must be greater than zero; value “%s” is not allowed."
msgstr ""
"TIFF x-dpi noldan katta bo'lishi kerak; “%s” qiymatiga ruxsat berilmagan."

#: gdk-pixbuf/io-tiff.c:977
#, c-format
msgid "TIFF y-dpi must be greater than zero; value “%s” is not allowed."
msgstr ""
"TIFF y-dpi noldan katta bo'lishi kerak; “%s” qiymatiga ruxsat berilmagan."

#: gdk-pixbuf/io-tiff.c:1018
msgid "Couldn’t write to TIFF file"
msgstr "TIFF fayliga yozib boʻlmadi"
