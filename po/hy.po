#: gdk-pixbuf/io-tiff.c:350
msgid "Failed to open TIFF image"
msgstr "Չհաջողվեց բացել TIFF պատկերը"

#: gdk-pixbuf/io-tiff.c:362 gdk-pixbuf/io-tiff.c:777
